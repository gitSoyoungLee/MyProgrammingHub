import java.io.BufferedReader;
import java.io.FileInputStream;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.List;
import java.util.StringTokenizer;

public class Solution {
	
	static int N;
    static int[][] map;      // 0: 빈칸, 1: Core
    static boolean[][] used; // 전선이 지나가는 칸 표시
    static int[] dr = {-1, 0, 1, 0}; // 상, 우, 하, 좌
    static int[] dc = {0, 1, 0, -1};

    static List<int[]> innerCores; // 가장자리에 붙어있지 않은 Core 좌표들
    static int bestCount;
    static int bestLength;

    public static void main(String[] args) throws Exception {

        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder sb = new StringBuilder();

        int T = Integer.parseInt(br.readLine().trim());

        for (int tc = 1; tc <= T; tc++) {
            N = Integer.parseInt(br.readLine().trim());
            map = new int[N][N];

            for (int i = 0; i < N; i++) {
                StringTokenizer st = new StringTokenizer(br.readLine());
                for (int j = 0; j < N; j++) {
                    map[i][j] = Integer.parseInt(st.nextToken());
                }
            }

            innerCores = new ArrayList<>();
            for (int i = 0; i < N; i++) {
                for (int j = 0; j < N; j++) {
                    if (map[i][j] == 1) {
                        boolean onEdge = (i == 0 || i == N - 1 || j == 0 || j == N - 1);
                        if (!onEdge) innerCores.add(new int[]{i, j});
                    }
                }
            }

            used = new boolean[N][N];
            bestCount = 0;
            bestLength = 0;

            dfs(0, 0, 0);

            sb.append("#").append(tc).append(" ").append(bestLength).append("\n");
        }

        System.out.print(sb);
        br.close();
    }

    // idx: innerCores 중 지금 처리 중인 Core 인덱스
    // count: 지금까지 연결 성공한 Core 개수, length: 지금까지 사용한 전선 길이 합
    static void dfs(int idx, int count, int length) {
        if (idx == innerCores.size()) {
            if (count > bestCount || (count == bestCount && length < bestLength)) {
                bestCount = count;
                bestLength = length;
            }
            return;
        }

        int r = innerCores.get(idx)[0];
        int c = innerCores.get(idx)[1];

        // 1) 4방향 중 실제로 연결 가능한 방향을 전부 시도
        for (int d = 0; d < 4; d++) {
            List<int[]> path = new ArrayList<>();
            int nr = r, nc = c;
            boolean ok = true;

            while (true) {
                nr += dr[d];
                nc += dc[d];
                if (nr < 0 || nr >= N || nc < 0 || nc >= N) { ok = false; break; }
                if (map[nr][nc] == 1 || used[nr][nc]) { ok = false; break; }
                path.add(new int[]{nr, nc});
                boolean onEdge = (nr == 0 || nr == N - 1 || nc == 0 || nc == N - 1);
                if (onEdge) break; // 가장자리 도달 전선 완성
            }

            if (ok) {
                for (int[] p : path) used[p[0]][p[1]] = true;
                dfs(idx + 1, count + 1, length + path.size());
                for (int[] p : path) used[p[0]][p[1]] = false; // 백트래킹
            }
        }

        // 2 Core는 연결하지 않는 경우도 반드시 시도
        dfs(idx + 1, count, length);
    }

}
